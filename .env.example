# Copy this file to `.env` in the repository root, then fill in the secrets:
#
#     cp .env.example .env
#
# These values are correct for running the stack with `docker compose up`.
# Do not commit your `.env` — it is gitignored and holds real credentials.

# --- database service -------------------------------------------------------
POSTGRES_USER="admin"
POSTGRES_PASSWORD="admin"

# --- frontend service -------------------------------------------------------
FRONTEND_PORT="3000"
# Read by the browser, so it must use the HOST port. Compose publishes the
# backend on 5050 (see `5050:5000` in docker-compose.yml), NOT 5000.
REACT_APP_BACKEND_API_BASE_URL="http://localhost:5050/"

# --- backend service --------------------------------------------------------
BACKEND_PORT=5000

# `mdma-database-container` is the database's hostname on the compose network.
# Using `localhost` here resolves to the backend container itself and fails
# with "P1001: Can't reach database server". If your password contains any of
# @ : / ? # [ ] then percent-encode it (e.g. `p@ss` -> `p%40ss`).
DATABASE_URL="postgresql://admin:admin@mdma-database-container:5432/mdma"

JWT_SECRET="change-me-in-production"

# Comma-separated list of browser origins allowed to call the API. Add an entry
# here if you run the frontend on another port (e.g. http://localhost:3001).
CORS_ALLOWED_ORIGINS="http://localhost:3000"
FRONTEND_URL="http://localhost:3000/"

# --- secrets: fill these in yourself ----------------------------------------
# Replace with your real Azure credentials to enable image uploads. The
# defaults below are the well-known Azurite emulator values: they are the
# right SHAPE (the account name must be a valid hostname label and the key
# must be valid base64) but they do not authenticate against anything, so
# uploads will fail until you supply real ones.
AZURE_STORAGE_ACCOUNT_NAME="devstoreaccount1"
AZURE_STORAGE_ACCESS_KEY="Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw=="

# Optional. Without it the server starts and logs a warning; AI image
# analysis is unavailable.
GOOGLE_GEMINI_API_KEY=""

# Gmail requires an App Password, not your account password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="<your-gmail-address>"
SMTP_PASS="<your-gmail-app-password>"

# --- optional (defaults shown) ----------------------------------------------
# STORAGE_BACKEND="azure"
# AZURE_CONTAINER="mdma-dev"
# PUBLIC_BASE_URL="http://localhost:5050"
# UPLOADS_DIR="uploads"
# SAVE_BARCODES="false"
